            "name": "Browse audio recordings",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/v3/audio/",
            "params": [
              {
                "name": "fo",
                "value": "json",
                "type": "query",
                "description": "Output format"
              },
              {
                "name": "q",
                "value": "",
                "type": "query",
                "description": "Search query to filter results"
              },
              {
                "name": "at",
                "value": "",
                "type": "query",
                "description": "Limit response to specific attribute(s)"
              },
              {
                "name": "sp",
                "value": "",
                "type": "query",
                "description": "Starting page number"
              },
              {
                "name": "c",
                "value": "",
                "type": "query",
                "description": "Number of results per page"
              }
            ]
          },
          "docs": "Returns items in the Audio Recordings format from loc.gov digital collections."
